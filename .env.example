# Canonical public origin. Replace with the verified production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mock is the only implemented provider. No Zoopla endpoints or credentials needed.
PROPERTY_DATA_SOURCE=mock
# Keep false for all demo and preview deployments.
SITE_INDEXABLE=false
# Optional verified public email: enables a user-initiated mailto enquiry.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional verified contact details shown on the contact page.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_OFFICE_HOURS=
# Browser-restricted Google Maps Embed API key. The map appears when this and the address are set.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
